      "id": "n013",
      "name": "Extract Trader Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse LLM trader extraction and update session\nconst response = $input.first().json;\nlet parsed = {};\ntry {\n  const content = response.choices[0].message.content;\n  const cleaned = content.replace(/^```json?\\s*/i, '').replace(/\\s*```$/i, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { trader_name: 'Unknown', whatsapp_number: '0000000000', business_category: 'Other', language: 'English' };\n}\n\nconst sender = $('Get Transcript').first().json.sender_phone;\nconst sessions = $getWorkflowStaticData('global').sessions;\nif (sessions[sender]) {\n  sessions[sender].trader_name = parsed.trader_name || 'Unknown';\n  sessions[sender].whatsapp_number = (parsed.whatsapp_number || '').replace(/[^0-9]/g, '').slice(-10);\n  sessions[sender].business_category = parsed.business_category || 'Other';\n  sessions[sender].language = parsed.language || 'English';\n  sessions[sender].state = 'waiting_profile_photo';\n}\n\nreturn [{\n  json: {\n    trader_name: sessions[sender].trader_name,\n    whatsapp_number: sessions[sender].whatsapp_number,\n    business_category: sessions[sender].business_category,\n    language: sessions[sender].language,\n    sender_phone: sender\n  }\n}];"
      },
