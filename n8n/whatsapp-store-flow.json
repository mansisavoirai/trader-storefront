      "parameters": {
        "jsCode": "// Get transcript from Whisper response or use text body directly\nconst incoming = $input.first().json;\nconst sessionData = $('Session Manager').first().json.session;\nconst msgType = $('Session Manager').first().json.message_type;\nconst msgBody = $('Session Manager').first().json.message_body;\n\nlet transcript = incoming.text || incoming.transcript || '';\nif (msgType === 'text' || !transcript) {\n  transcript = msgBody;\n}\n\nreturn [{\n  json: {\n    transcript: transcript,\n    sender_phone: $('Session Manager').first().json.sender_phone,\n    session: sessionData\n  }\n}];"
      },
