      "parameters": {
        "jsCode": "// Assemble final store payload from session data\nconst sender = $input.first().json.sender_phone;\nconst sessions = $getWorkflowStaticData('global').sessions;\nconst session = sessions[sender];\n\nconst payload = {\n  name: session.trader_name,\n  whatsapp_number: session.whatsapp_number,\n  business_category: session.business_category,\n  profile_photo_url: session.profile_photo_url,\n  bio: '',\n  language: session.language,\n  products: session.products.map(function(p) {\n    return {\n      name: p.name,\n      price_inr: p.price_inr,\n      description: p.description,\n      photo_url: p.photo_url,\n      language: p.language\n    };\n  })\n};\n\nreturn [{\n  json: {\n    sender_phone: sender,\n    product_count: session.products.length,\n    payload: payload\n  }\n}];"
      },
