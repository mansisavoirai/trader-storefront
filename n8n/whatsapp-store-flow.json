              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\"model\": \"openai/gpt-oss-20b\", \"messages\": [{\"role\": \"system\", \"content\": \"You are a data extractor for a trader storefront system. Extract trader details from a voice note transcript. Return valid JSON only \u2014 no extra text before or after.\"}, {\"role\": \"user\", \"content\": \"Extract trader details from this transcript: \" + $json.transcript}], \"temperature\": 0.1, \"response_format\": {\"type\": \"json_object\"}}) }}",
        "options": {
          "timeout": 30000
        }
