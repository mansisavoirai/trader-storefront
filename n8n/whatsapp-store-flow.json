    {
      "parameters": {
        "jsCode": "// Parse product extraction, save to session, clear temp photo\nconst llmResp = $input.first().json;\nconst sender = $('Get Product Transcript').first().json.sender_phone;\nconst sessions = $getWorkflowStaticData('global').sessions;\n\nlet parsed = {};\ntry {\n  const content = llmResp.choices[0].message.content;\n  const cleaned = content.replace(/^```json?\\s*/i, '').replace(/\\s*```$/i, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { product_name: 'Unknown Product', price_inr: 0, description: null, language: 'English' };\n}\n\nif (sessions[sender]) {\n  sessions[sender].products.push({\n    name: parsed.product_name || 'Unknown Product',\n    price_inr: parseFloat(parsed.price_inr) || 0,\n    description: parsed.description || null,\n    photo_url: sessions[sender].last_product_photo_url,\n    language: parsed.language || 'English'\n  });\n  sessions[sender].product_count = sessions[sender].products.length;\n  sessions[sender].last_product_photo_url = '';\n}\n\nreturn [{\n  json: {\n    sender_phone: sender,\n    product_count: sessions[sender].product_count,\n    product_name: parsed.product_name || 'Product',\n    session: sessions[sender]\n  }\n}];"
      },
