      "id": "n001",
      "name": "Twilio Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        460
      ],
      "webhookId": "trader-store-twilio-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Parse Twilio WhatsApp webhook payload\n// Twilio sends: From, Body, NumMedia, MediaUrl0, MediaContentType0\nconst body = $input.first().json.body || $input.first().json;\nconst from = body.From || '';\nconst messageBody = (body.Body || '').trim();\nconst numMedia = parseInt(body.NumMedia || '0', 10);\n\nconst senderPhone = from.replace('whatsapp:', '').replace('+', '');\nconst messageUpper = messageBody.toUpperCase();\n\nlet messageType = 'text';\nlet mediaUrl = '';\n\nif (numMedia > 0) {\n  mediaUrl = body['MediaUrl' + (numMedia - 1)] || body.MediaUrl0 || '';\n  const ct = body['MediaContentType' + (numMedia - 1)] || body.MediaContentType0 || '';\n  if (ct.startsWith('audio/') || ct.startsWith('voice/')) {\n    messageType = 'audio';\n  } else if (ct.startsWith('image/')) {\n    messageType = 'image';\n  } else {\n    messageType = 'media';\n  }\n}\n\nreturn [{\n  json: {\n    sender_phone: senderPhone,\n    message_body: messageBody,\n    message_upper: messageUpper,\n    message_type: messageType,\n    media_url: mediaUrl\n  }\n}];"
      },
      "id": "n002",
      "name": "Parse Twilio Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "// Session Manager - routes each incoming message based on conversation state\n// Uses n8n workflow staticData for persistence across webhook calls\nconst sender = $input.first().json.sender_phone;\nconst msg = $input.first().json.message_body;\nconst msgType = $input.first().json.message_type;\nconst msgUpper = $input.first().json.message_upper;\nconst mediaUrl = $input.first().json.media_url;\n\nif (!$getWorkflowStaticData('global').sessions) {\n  $getWorkflowStaticData('global').sessions = {};\n}\nconst sessions = $getWorkflowStaticData('global').sessions;\n\nif (!sessions[sender]) {\n  sessions[sender] = {\n    state: 'idle',\n    trader_name: '',\n    whatsapp_number: '',\n    business_category: '',\n    language: 'English',\n    profile_photo_url: '',\n    products: [],\n    last_product_photo_url: '',\n    product_count: 0\n  };\n}\n\nconst session = sessions[sender];\nconst isStoreCmd = (msgUpper === 'STORE');\nconst isDoneCmd = (msgUpper === 'DONE');\nlet route = 'ignore';\n\nif (isStoreCmd) {\n  session.state = 'waiting_voice_note';\n  session.products = [];\n  session.product_count = 0;\n  session.profile_photo_url = '';\n  session.last_product_photo_url = '';\n  route = 'welcome';\n} else if (session.state === 'waiting_voice_note' && (msgType === 'audio' || msgType === 'text')) {\n  route = 'process_voice';\n} else if (session.state === 'waiting_profile_photo' && msgType === 'image') {\n  route = 'process_photo';\n} else if (session.state === 'collecting_products') {\n  if (isDoneCmd) {\n    route = 'build_store';\n  } else if (msgType === 'image') {\n    session.last_product_photo_url = mediaUrl;\n    route = 'photo_received_ack';\n  } else if ((msgType === 'audio' || msgType === 'text') && session.last_product_photo_url) {\n    route = 'add_product';\n  }\n}\n\nreturn [{\n  json: {\n    sender_phone: sender,\n    message_body: msg,\n    message_type: msgType,\n    media_url: mediaUrl,\n    route: route,\n    session: session\n  }\n}];"
      },
