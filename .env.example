# ============================================
# Trader Storefront Generator - Environment Variables
# ============================================

# --- FASTAPI APP (required for production) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- GROQ AI (used by n8n workflow, not by FastAPI directly) ---
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- TWILIO (used by n8n WhatsApp workflow) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- n8n WORKFLOW ENVIRONMENT VARIABLES ---
# Add these in n8n's Environment Variables settings (Settings > Variables)
# The n8n workflow references these via $env.VARIABLE_NAME

STORE_API_URL=https://your-deployed-app.railway.app
GROQ_API_KEY=gsk_your_groq_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- DATABASE (optional, defaults to SQLite) ---
DATABASE_URL=sqlite:///trader_storefront.db
